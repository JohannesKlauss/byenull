  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohannesKlauss/byenull.git",
    "directory": "packages/byenull"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",

{
  "name": "byenull-testing",
  "version": "0.1.0",
  "description": "Testing utilities for for byenull.",
  "homepage": "https://github.com/JohannesKlauss/byenull#readme",
  "bugs": {
    "url": "https://github.com/JohannesKlauss/byenull/issues"
  },
  "license": "MIT",
  "author": "Johannes Klauss <klauss.johannes@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohannesKlauss/byenull.git",
    "directory": "packages/testing"
  },
  "keywords": [
    "option",
    "null",
    "undefined",
    "functional",
    "test"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "byenull": "workspace:*"
  }
}

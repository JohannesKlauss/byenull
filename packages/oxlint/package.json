{
  "name": "byenull-oxlint",
  "version": "0.1.1",
  "description": "Oxlint plugin/preset for byenull.",
  "keywords": [
    "functional",
    "javascript",
    "null",
    "option",
    "oxlint",
    "typescript",
    "undefined"
  ],
  "homepage": "https://byenull.netlify.app/",
  "bugs": {
    "url": "https://github.com/JohannesKlauss/byenull/issues"
  },
  "license": "MIT",
  "author": "Johannes Klauss <klauss.johannes@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohannesKlauss/byenull.git",
    "directory": "packages/oxlint"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.88.0"
  },
  "devDependencies": {
    "dedent": "1.7.2",
    "oxlint": "1.88.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "byenull": "workspace:^",
    "oxlint": "^1.0.0"
  }
}
